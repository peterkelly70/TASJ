    color: #00FF00;
    border: 1px solid #00FF00;
    padding: 5px;
    font-family: "Courier New";
}
QPushButton:hover {
    background-color: #003300;
    border: 1px solid #00FF00;
}
QTextEdit {
    background-color: #000000;
    color: #00FF00;
    border: 1px solid #00FF00;
    font-family: "Courier New";
}
QProgressBar {
    border: 1px solid #00FF00;
    background-color: #000000;
    text-align: center;
}
QProgressBar::chunk {
    background-color: #003300;
}
/* Matrix-style text effect */
QLabel, QMenu::item {
    font-family: "Courier New";
}
